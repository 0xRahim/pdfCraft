# PdfCraft API
PORT=3001
JWT_SECRET=dev-pdfcraft-secret-change-me
JWT_EXPIRES_IN=7d
DATABASE_URL=./data/pdfcraft.db
RENDER_DIR=./storage/renders
DEMO_EMAIL=demo@pdfcraft.dev
DEMO_PASSWORD=Demo1234!
CORS_ORIGINS=http://localhost:3000
# Path to system Chrome/Chromium. Puppeteer uses this if set;
# falls back to /usr/bin/chromium, then its bundled Chrome.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
